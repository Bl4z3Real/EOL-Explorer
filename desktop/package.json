{
  "name": "eol-explorer",
  "productName": "EOL Explorer",
  "version": "1.0.0",
  "description": "EOL Explorer - il browser con l'anima anni '90",
  "main": "main.js",
  "author": "EOL",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "it.eol.explorer",
    "productName": "EOL Explorer",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "renderer/**/*"],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
